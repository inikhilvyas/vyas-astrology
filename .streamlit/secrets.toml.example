GEMINI_API_KEY = "<PASTE_PRIMARY_GEMINI_API_KEY_HERE>"
GEMINI_API_KEY_1 = "<PASTE_BACKUP_GEMINI_KEY_1_HERE>"

# 3. DeepSeek (DeepSeek-V3, DeepSeek-R1 - High reasoning & economical)
DEEPSEEK_API_KEY = "<PASTE_PRIMARY_DEEPSEEK_API_KEY_HERE>"
DEEPSEEK_API_KEY_1 = "<PASTE_BACKUP_DEEPSEEK_KEY_1_HERE>"

# 4. OpenAI (ChatGPT / GPT-4o / GPT-4o-mini)
OPENAI_API_KEY = "<PASTE_PRIMARY_OPENAI_API_KEY_HERE>"
OPENAI_API_KEY_1 = "<PASTE_BACKUP_OPENAI_KEY_1_HERE>"

# 5. OpenRouter (Unified router for 200+ AI models including Claude)
OPENROUTER_API_KEY = "<PASTE_OPENROUTER_API_KEY_HERE>"

# Calculation / Task-Specific Keys (Optional):
# - CHAT_GROQ_API_KEY: Dedicated ultra-fast (<0.3s) key for Live Consultation
# - REPORT_GEMINI_API_KEY: Dedicated deep synthesis key for 56-page Dossier PDF
CHAT_GROQ_API_KEY = "<PASTE_CHAT_SPECIFIC_GROQ_KEY_HERE>"
